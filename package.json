{
  "name": "pi-atif",
  "version": "0.1.0",
  "description": "Pi package that emits Harbor ATIF-v1.7 agent trajectories.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./mapper": {
      "types": "./dist/mapper.d.ts",
      "import": "./dist/mapper.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "atif",
    "harbor",
    "trajectory",
    "agent-traces"
  ],
  "author": "Arya Bhuptani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryabhuptani/pi-atif.git"
  },
  "bugs": {
    "url": "https://github.com/aryabhuptani/pi-atif/issues"
  },
  "homepage": "https://github.com/aryabhuptani/pi-atif#readme",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "validate:openagents": "tsx scripts/validate-openagents.ts",
    "validate:harbor": "bash scripts/validate-harbor.sh",
    "validate": "npm run validate:openagents && npm run validate:harbor"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@openagentsinc/atif": "0.1.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
